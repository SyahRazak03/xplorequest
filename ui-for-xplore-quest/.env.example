# =============================================================
# XploreQuest — Frontend Environment Variables Example
# =============================================================

# Backend Cloud Function Base URL
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/PLACEHOLDER_FIREBASE_PROJECT_ID/asia-southeast1/api

# ── Firebase Client SDK Config ───────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=PLACEHOLDER_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=PLACEHOLDER_FIREBASE_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=PLACEHOLDER_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_APP_ID=PLACEHOLDER_FIREBASE_APP_ID

# ── Google Maps SDK (Android & iOS) ──────────────────────────
# Restricted API keys from Google Cloud Console
GOOGLE_MAPS_API_KEY_ANDROID=PLACEHOLDER
GOOGLE_MAPS_API_KEY_IOS=PLACEHOLDER
