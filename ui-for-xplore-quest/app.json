{
  "expo": {
    "name": "XploreQuest",
    "slug": "xplore-quest",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/XploreQuest_Icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/XploreQuest_Icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syahzxyz.xplorequest",
      "config": {
        "googleMapsApiKey": "AIzaSyAfJAm6O8LX1PNGMTtqaNmLApLCEzg6Zps"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "XploreQuest requires location access to detect checkpoint arrivals and verify event geofence zones."
      }
    },
    "android": {
      "package": "com.syahzxyz.xplorequest",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAfJAm6O8LX1PNGMTtqaNmLApLCEzg6Zps"
        }
      },
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FAF9F6"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/XploreQuest_Icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share images for checkpoints."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9b74acd4-461a-4684-8aa6-875b8b36ee7b"
      }
    },
    "owner": "syahzxyz",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9b74acd4-461a-4684-8aa6-875b8b36ee7b"
    }
  }
}
