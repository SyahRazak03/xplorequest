# =============================================================
# XploreQuest — Environment Variables Reference
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to version control.
# =============================================================

# ── Firebase Project ─────────────────────────────────────────
# Your Firebase project ID (e.g. xplorequest-cab6c)
XQ_PROJECT_ID=PLACEHOLDER

# Region for Cloud Functions and Firestore
# Must match the location chosen at project creation (asia-southeast1)
XQ_REGION=asia-southeast1

# ── Service Account (local dev / CI only) ───────────────────
# Absolute or relative path to the downloaded service-account JSON key.
# Used only when running outside the Firebase emulator with Application
# Default Credentials (ADC). Leave empty in production — GCP handles ADC.
# NEVER commit the actual JSON file.
SERVICE_ACCOUNT_PATH=PLACEHOLDER

# ── Firebase Admin SDK (alternative to file-based key) ───────
# Base64-encoded service account JSON (for CI/CD environments).
# Generate with: base64 -i serviceAccount.json
SERVICE_ACCOUNT_BASE64=PLACEHOLDER

# ── Authentication ────────────────────────────────────────────
# Secret used to sign/verify HMAC tokens (e.g. webhook signatures).
HMAC_SECRET=PLACEHOLDER

# Session cookie configuration (Stage 2)
SESSION_COOKIE_NAME=xplorequest_session
SESSION_COOKIE_MAX_AGE_MS=604800000

# ── Firebase App Check ────────────────────────────────────────
# Controls App Check token enforcement (true in production, set to false for local dev/testing).
APP_CHECK_ENFORCE=true

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=1.0.0

# ── Emulator Overrides (local dev) ────────────────────────────
# Uncomment these when running with firebase emulators:start
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Firebase Web API Key (Stage 3 Auth) ───────────────────────
# The Web API Key from Firebase Console → Project settings → General.
# Used by the backend to verify admin email/password via Firebase Auth
# REST API (identitytoolkit.googleapis.com).
# This is the PUBLIC web key — safe to store in .env (not a service account key).
WEB_API_KEY=PLACEHOLDER

# ── Demo Account Seeding (Stage 3 seed script only) ───────────
# Read by functions/scripts/seed.ts to create demo accounts in Firebase Auth.
# These values are NEVER hardcoded in application code.
# Use a strong password in production; keep demo credentials separate.
DEMO_ADMIN_EMAIL=azman@xplorequest.com
DEMO_ADMIN_PASSWORD=PLACEHOLDER_change_me

# ── Frontend Client Config (for authService.ts in the Expo app) ─
# These map to firebaseConfig in the Firebase JS SDK initializeApp() call.
# All EXPO_PUBLIC_ vars are safe to bundle — they are the public client config,
# not service account keys.
EXPO_PUBLIC_FIREBASE_API_KEY=PLACEHOLDER
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=PLACEHOLDER.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=PLACEHOLDER
EXPO_PUBLIC_FIREBASE_APP_ID=PLACEHOLDER

# Backend Cloud Function base URL (used by authService.ts)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/PLACEHOLDER/asia-southeast1/api
